# ── Server ──────────────────────────────────────────────
PORT=4001
NODE_ENV=development
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────
MONGODB_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── OTP ──────────────────────────────────────────────────
OTP_TTL=600
OTP_RESEND_COOLDOWN=180
OTP_RATE_MAX_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_HMAC_SECRET=your_secret_hmac_key_here

# ── Email (Brevo) ────────────────────────────────────────
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=

# ── JWT ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_EXP=15m
REFRESH_TOKEN_EXP=7d
ACCESS_TOKEN_EXP_SEC=900
REFRESH_TOKEN_EXP_SEC=604800

# ── Bunny Storage (images: thumbnails, avatars) ──────────
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOST=de.storage.bunnycdn.com
BUNNY_CDN_URL=

# ── Bunny Stream (lesson videos) ──────────
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# ── Cache ────────────────────────────────────────────────
REDIS_USER_TTL=86400
